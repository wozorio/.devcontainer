{
  "name": "Bubble",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu26.04",
  "runArgs": ["--hostname", "bubble"],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true,
      "installOhMyZsh": true,
      "ohMyZshTheme": "robbyrussell"
    },
    "ghcr.io/devcontainers-extra/features/mise:1": {},
    "ghcr.io/microsoft/codespace-features/artifacts-helper": {}
  },
  "containerEnv": {
    "MISE_GLOBAL_CONFIG_FILE": "${containerWorkspaceFolder}/.devcontainer/bubble/mise.toml",
    "MISE_DATA_DIR": "/mnt/mise-data"
  },
  "remoteEnv": {
    "PATH": "/mnt/mise-data/shims:${containerEnv:PATH}"
  },
  "initializeCommand": "mkdir -p $HOME/.agents/skills && exit 0",
  "mounts": [
    "source=mise-data-${devcontainerId},target=/mnt/mise-data,type=volume",
    "source=dotnet-tools-${devcontainerId},target=/home/vscode/.dotnet/tools,type=volume",
    "source=nuget-cache,target=/home/vscode/.nuget,type=volume",
    "source=zsh-history,target=/commandhistory,type=volume",
    "source=${localEnv:HOME}/.agents/skills,target=/home/vscode/.agents/skills,type=bind,consistency=cached"
  ],
  "postCreateCommand": [".devcontainer/bubble/post-create.sh"],
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "astral-sh.ty",
        "charliermarsh.ruff",
        "csharpier.csharpier-vscode",
        "emeraldwalk.runonsave",
        "esbenp.prettier-vscode",
        "hashicorp.terraform",
        "mkhl.shfmt",
        "ms-azure-devops.azure-pipelines",
        "ms-azuretools.vscode-containers",
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-dotnettools.vscode-dotnet-runtime",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.vscode-python-envs",
        "ms-vscode.makefile-tools",
        "redhat.vscode-yaml"
      ],
      "settings": {
        // Editor
        "editor.tabSize": 2,
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.formatOnSave": true,
        "editor.formatOnSaveMode": "file",
        "editor.semanticHighlighting.enabled": true,

        // Files
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,

        // Prettier
        "prettier.tabWidth": 2,
        "prettier.printWidth": 125,

        // Kubernetes
        "vs-kubernetes": {
          "vs-kubernetes.crd-code-completion": "disabled"
        },
        "vscode-kubernetes.kubectl-path": "/mnt/mise-data/shims/kubectl",
        "vscode-kubernetes.helm-path": "/mnt/mise-data/shims/helm",

        // C# (.NET)
        "[csharp]": {
          "editor.defaultFormatter": "csharpier.csharpier-vscode"
        },

        // Docker
        "[dockerfile]": {
          "editor.defaultFormatter": "ms-azuretools.vscode-containers"
        },
        "[dockercompose]": {
          "editor.defaultFormatter": "ms-azuretools.vscode-containers"
        },

        // Helm
        "[helm]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },

        // GitHub Actions
        "[github-actions-workflow]": {
          "editor.defaultFormatter": "redhat.vscode-yaml"
        },

        // Makefile
        "[makefile]": {
          "editor.tabSize": 8,
          "editor.insertSpaces": false
        },
        "makefile.configureOnOpen": false,
        "makefile.configureOnEdit": false,
        "makefile.configureAfterCommand": false,

        // Markdown
        "[markdown]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        // Packer
        "emeraldwalk.runonsave": {
          "commands": [
            {
              "match": "\\.(pkr.hcl|pkrvars.hcl)$",
              "cmd": "packer fmt ${file}"
            }
          ]
        },

        // Python
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.tabSize": 4,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        },
        // python.languageServer set to "None" so that Astral ty handles type checking
        "python.languageServer": "None",
        "python.analysis.typeCheckingMode": "standard",
        "python-envs.alwaysUseUv": true,
        "ty.experimental.useUv": "on",

        // JSON
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[jsonc]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        // Javascript
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },

        // Shellscript
        "[shellscript]": {
          "editor.defaultFormatter": "mkhl.shfmt",
          "editor.tabSize": 4
        },
        "shfmt.executableArgs": ["-i", "4"],

        // Terraform
        "terraform.validation.enableEnhancedValidation": false,
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.codeActionsOnSave": {
            "source.formatAll.terraform": "always"
          }
        },
        "[terraform-vars]": {
          "editor.defaultFormatter": "hashicorp.terraform",
          "editor.codeActionsOnSave": {
            "source.formatAll.terraform": "always"
          }
        },

        // Ansible
        "yaml.schemas": {
          "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/vars.json": ["*/defaults/**"],
          "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/meta.json": ["*/meta/**"],
          "https://raw.githubusercontent.com/ansible/ansible-lint/main/src/ansiblelint/schemas/ansible.json#/$defs/tasks": [
            "*/handlers/**",
            "*/tasks/**"
          ]
        },

        // Azure pipelines
        "[azure-pipelines]": {
          "editor.defaultFormatter": "ms-azure-devops.azure-pipelines"
        },
        "files.associations": {
          "**/pipelines/*.yml": "azure-pipelines"
        },

        // YAML
        "[yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml",
          "editor.autoIndent": "keep",
          "diffEditor.ignoreTrimWhitespace": false,
          "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
          },
          "editor.suggest.insertMode": "replace"
        },
        "yaml.disableSchemaDetection": ["**/pipelines/*.yml", "azure-pipelines.yml", "azure-pipelines.yaml"]
      }
    }
  }
}
